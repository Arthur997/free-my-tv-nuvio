<?xml version="1.0" encoding="utf-8"?>
<!-- Performance mode: the app's window fades in over the home screen, short and cheap for a weak GPU. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:fromAlpha="0" android:toAlpha="1" android:duration="160"
    android:interpolator="@android:interpolator/decelerate_quad" />
